# Worker-only environment variables

# Supabase (uses service role for admin access)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Redis (worker converts https:// to rediss://)
UPSTASH_REDIS_URL=https://your-redis.upstash.io
UPSTASH_REDIS_TOKEN=your-redis-token

# Cloudflare R2
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET_NAME=kavach-uploads
R2_ENDPOINT=https://your-account.r2.cloudflarestorage.com

# AI
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:14b
GEMINI_API_KEY=your-gemini-api-key

# Temp directory for scan files
TEMP_SCAN_DIR=/tmp/kavach-scans

# Auto-fix model routing (Phase 2)
# Small files (< 200 lines) use SMALL model for speed
# Large files (>= 200 lines) use LARGE model for accuracy
OLLAMA_FIX_MODEL_SMALL=qwen2.5-coder:7b
OLLAMA_FIX_MODEL_LARGE=qwen2.5-coder:14b
