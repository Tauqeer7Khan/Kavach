# ─── Supabase ────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Supabase Pooled Connection (for Next.js API routes)
# Get from: Supabase Dashboard → Settings → Database → Connection String → URI (Transaction Pooler)
# Use port 6543 (pooler)
DATABASE_URL_POOLED=postgresql://postgres.xxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres

# ─── Cloudflare R2 Storage ───────────────────────────
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET_NAME=kavach-uploads
R2_ENDPOINT=https://your-account.r2.cloudflarestorage.com

# ─── GitHub OAuth (via Supabase) ─────────────────────
GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret

# ─── AI Services ─────────────────────────────────────
# Google Gemini (backup AI)
GEMINI_API_KEY=your-gemini-api-key

# Ollama (local AI - worker only)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:14b

# ─── App Configuration ───────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Coupon Code for Enterprise upgrade
# Users enter this in Settings page to unlock Enterprise features
COUPON_ENTERPRISE=your-secret-coupon-code-here